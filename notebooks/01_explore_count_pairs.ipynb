import pandas as pd

def count_pairs(name):
    df = pd.read_csv(f"data/raw/{name}_ic50_raw.csv", low_memory=False)
    df = df[(df["standard_relation"] == "=") & (df["standard_value"] > 0)].copy()
    df = df[df["assay_variant_mutation"] != "UNDEFINED MUTATION"]
    wt = df[df["assay_variant_mutation"].isna()]
    mut = df.dropna(subset=["assay_variant_mutation"])
    
    print(f"\n{name}: {len(wt)} wild-type rows, {len(mut)} mutant rows")
    
    for m,g in mut.groupby("assay_variant_mutation"):
        any_pair = set(g["molecule_chembl_id"]) & set(wt["molecule_chembl_id"])
        g2 = g[["molecule_chembl_id", "document_chembl_id"]].drop_duplicates()
        w2 = wt[["molecule_chembl_id", "document_chembl_id"]].drop_duplicates()
        same_doc = g2.merge(w2, on = ["molecule_chembl_id", "document_chembl_id"])
        

        print(f" {m:22s} mutant rows {len(g):5d} | molecules also on WT: {len(any_pair):5d} | same paper: {same_doc['molecule_chembl_id'].nunique():5d}")

count_pairs("EGFR")
count_pairs("BRAF") 
